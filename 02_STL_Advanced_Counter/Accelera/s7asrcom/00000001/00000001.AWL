ORGANIZATION_BLOCK OB 1
TITLE = "Main Program Sweep (Cycle)"
VERSION : 0.1


VAR_TEMP
  OB1_EV_CLASS : BYTE ;	//Bits 0-3 = 1 (Coming event), Bits 4-7 = 1 (Event class 1)
  OB1_SCAN_1 : BYTE ;	//1 (Cold restart scan 1 of OB 1), 3 (Scan 2-n of OB 1)
  OB1_PRIORITY : BYTE ;	//Priority of OB Execution
  OB1_OB_NUMBR : BYTE ;	//1 (Organization block 1, OB1)
  OB1_RESERVED_1 : BYTE ;	//Reserved for system
  OB1_RESERVED_2 : BYTE ;	//Reserved for system
  OB1_PREV_CYCLE : INT ;	//Cycle time of previous OB1 scan (milliseconds)
  OB1_MIN_CYCLE : INT ;	//Minimum cycle time of OB1 (milliseconds)
  OB1_MAX_CYCLE : INT ;	//Maximum cycle time of OB1 (milliseconds)
  OB1_DATE_TIME : DATE_AND_TIME ;	//Date and time OB1 started
END_VAR
BEGIN
NETWORK
TITLE =

// 1. Reset to ZERO if switch is OFF
      AN    I      0.0; // If main switch is OFF
      JCN   skp0; 
      L     0; 
      T     MD    10; // Force counter to 0
skp0: NOP   0; 

// 2. Start the 5s timer (Auto-resets when buttons are released)
      A     I      0.0; // Switch must be ON
      A(    ; 
      O     I      0.1; // UP button pressed
      O     I      0.2; // OR DOWN button pressed
      )     ; 
      L     S5T#5S; 
      SD    T      1; // Starts timer. Drops to 0 instantly if released.

      A     T      1; 
      =     M      0.1; // M0.1 goes HIGH after 5s

// 3. One-Second Pulse Timer
      A     I      0.0; // Main switch is ON
      AN    M      0.2; // MUST be the memory bit to delay the reset!
      L     S5T#1S; 
      SD    T      2; 

      A     T      2; 
      =     M      0.2; // Pulses HIGH for exactly ONE scan cycle

// 4. UP Logic: First 5 Seconds (+1)
      A     I      0.0; 
      AN    M      0.1; // Under 5 seconds
      A     M      0.2; // 1-second pulse
      A     I      0.1; // UP button
      JCN   skp1; 
      L     MD    10; 
      L     1; 
      +D    ; 
      T     MD    10; 
skp1: NOP   0; 

// 5. DOWN Logic: First 5 Seconds (-1)
      A     I      0.0; 
      AN    M      0.1; // Under 5 seconds
      A     M      0.2; // 1-second pulse
      A     I      0.2; // DOWN button
      JCN   skp2; 
      L     MD    10; 
      L     1; 
      -D    ; 
      T     MD    10; 
skp2: NOP   0; 

// 6. UP Logic: After First 5 Seconds (+5)
      A     I      0.0; 
      A     M      0.1; // Under 5 seconds
      A     M      0.2; // 1-second pulse
      A     I      0.1; // UP button
      JCN   skp3; 
      L     MD    10; 
      L     5; 
      +D    ; 
      T     MD    10; 
skp3: NOP   0; 

// 7. DOWN Logic: After First 5 Seconds (-5)
      A     I      0.0; 
      A     M      0.1; // Under 5 seconds
      A     M      0.2; // 1-second pulse
      A     I      0.2; // DOWN button
      JCN   skp4; 
      L     MD    10; 
      L     5; 
      -D    ; 
      T     MD    10; 
skp4: NOP   0; 
      L     MD    10; 
      L     0; 
      <=D   ; 
      JCN   skp5; 
      L     0; 
      T     MD    10; 
skp5: NOP   0; 
      L     MD    10; 
      L     L#100000; 
      >=D   ; 
      JCN   skp6; 
      L     L#100000; 
      T     MD    10; 
skp6: NOP   0; 

END_ORGANIZATION_BLOCK

