FUNCTION FC 1 : VOID
TITLE =
VERSION : 0.1

BEGIN
NETWORK
TITLE =

      AN    "mid level"; 
      S     "valve 4"; 
NETWORK
TITLE =

      A     "high level"; 
      R     "valve 4"; 
END_FUNCTION

FUNCTION FC 2 : VOID
TITLE =
VERSION : 0.1

BEGIN
NETWORK
TITLE =

      A     "mid level 2"; 
      S     "valve 1"; 
      S     "valve 2"; 
NETWORK
TITLE =

      A     "valve 1"; 
      L     S5T#5S; 
      SD    T      0; 
      NOP   0; 
      NOP   0; 
      NOP   0; 
      A     T      0; 
      S     "p1"; 
NETWORK
TITLE =

      O     "high level 2"; 
      ON    "low level 1"; 
      R     "valve 1"; 
      R     "valve 2"; 
      R     "p1"; 
NETWORK
TITLE =

NETWORK
TITLE =

NETWORK
TITLE =

      L     MD    12; 
      L     MD    16; 
      -I    ; 
      T     MD    20; 
      NOP   0; 
NETWORK
TITLE =

      L     MD    20; 
      L     1.500000e+000; 
      >=R   ; 
      =     "x2"; 
NETWORK
TITLE =

      A     "x2"; 
      L     S5T#5M; 
      SD    T      4; 
      NOP   0; 
      NOP   0; 
      NOP   0; 
      A     T      4; 
      S     "x3"; 
END_FUNCTION

